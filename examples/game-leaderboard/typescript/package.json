{
  "name": "echovalue-game-leaderboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A game leaderboard backed by EchoValue key-value storage, with no database.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "test": "node --test src/leaderboard.test.ts src/echo-value.test.ts src/server.test.ts",
    "test:live": "node --test src/live.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
