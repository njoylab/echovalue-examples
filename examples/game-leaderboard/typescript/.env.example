# Server-side only. Never exposed to the browser.
# Get a free token (100 credits, no registration):
#   curl 'https://api.echovalue.dev/token' -d 'token=new'
ECHOVALUE_TOKEN=

# Storage namespace (max 30 chars, [A-Za-z0-9_-])
LEADERBOARD_BUCKET=leaderboard
LEADERBOARD_KEY=scores
LEADERBOARD_TTL=2592000

# HTTP port for the local server
PORT=3000
